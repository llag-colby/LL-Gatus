*.iml
.idea
.vscode

# OS
.DS_Store

# JS
node_modules

# Go
/vendor

# Misc
*.db
*.db-shm
*.db-wal
gatus
config/config.yml
config.yaml
# Local build artifacts / scratch
*.tar
gatus-local.tar
scratch_*

# Runtime data (sqlite history) — never track or clean
/data/

# Secrets — never commit (repo is public)
.env
.env.*
!.env.example

# Collector runtime state (learned phone baseline)
collector/.phones_state.json
science-resp.log

# Python
__pycache__/

# UniFi discovery row cache (rebuilt every successful sweep)
collector/.unifi_sites.json

# WinRM client/CA material for the hypervisor collector. The CA private key can
# issue a certificate that authenticates to every hardened host, so none of this
# belongs in git. Regenerate with collector/winrm-make-certs.sh.
collector/winrm-certs/
*.pfx
*.pass
# Generated by collector/setup-winrm.sh. Embeds every host's server
# certificate AND private key, so it is as sensitive as the certs dir.
collector/gatus-winrm-setup.ps1
