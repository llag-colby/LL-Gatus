# Copy to .env and fill in real values. .env is gitignored (never committed).
# On the prod box, create this ONCE — `update.sh` (git clean -fd) preserves it.

# Wildix global API key (reserved for future use)
WILDIX_API_KEY=wsk-v1-your-key-here

# Phones — Ivory Tower PBX access token (Wildix Simple Token; the collector reads the PBX with it)
PHONES_IVORY_TOWER_TOKEN=access_your-pbx-token-here

# Phones — shared PUSH token. Same value in config.yaml (external-endpoints) and the collector.
PHONES_PUSH_TOKEN=generate-with-openssl-rand-hex-20

# --- LL-Telemetry (the /ll-telemetry console) -----------------------------
# DISABLED. The telemetry routes are not registered, so nothing reads any of
# the keys in this block or the one below. They are kept for the day it is
# switched back on (see docs/ll-telemetry.md).
# The telemetry FastAPI has no authentication of its own, so Gatus is the
# boundary. Unset means telemetry fails CLOSED and shows a not-configured
# notice rather than exposing machine transcripts and ingest-key management.
TELEMETRY_UI_USER=llops
# Preferred: a bcrypt hash. Generate one with
#   docker run --rm python:3-slim sh -c "pip -q install bcrypt && python -c \
#     \"import bcrypt;print(bcrypt.hashpw(b'YOUR-PASSWORD',bcrypt.gensalt()).decode())\""
TELEMETRY_UI_PASSWORD_BCRYPT=
# Fallback if you are not using a hash. If both are set, the hash wins.
TELEMETRY_UI_PASSWORD=
# Where the telemetry API lives; this default suits docker-compose.telemetry.yml.
TELEMETRY_UPSTREAM_URL=http://lltel-api:8080

# --- LL-Telemetry stack (docker-compose.telemetry.yml only) ---------------
# Only needed when running the telemetry stack locally alongside Gatus.
LL_INGEST_TOKEN=
LL_DB_PASS=
LL_DB_ROOT_PASS=

# Gates the dashboard target editor (PATCH/DELETE /api/v1/endpoints/:key/target),
# the only write routes on this server that require a credential. Unset means
# target editing is disabled, not open. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
GATUS_EDIT_TOKEN=

# --- SMB share monitoring (collector/smb_collector.py) --------------------
# A read-only service account used to actually mount the watched shares. The
# collector opens each share, lists its root and reads its free space; it never
# writes. Grant Read only, on these four shares:
#   \\rr-fs01\Company Hub   \\llfs01\exports
#   \\llfs01\ReportHub(Shoals)
# Without these every SMB row reports "no smb reporting" and reads BLACK on the
# dashboard, which means "not configured", not "outage".
SMB_USER=
SMB_PASS=
# Degraded (amber, not a down alert) when free space is below BOTH of these.
SMB_FREE_WARN_PCT=10
SMB_FREE_WARN_GB=20
# Degraded when the root listing takes longer than this, in milliseconds.
SMB_SLOW_MS=4000

# --- Hypervisor monitoring (collector/hv_collector.py) --------------------
# WinRM account used to read CPU, memory, volumes and the guest inventory from
# each Hyper-V host. Falls back to SMB_USER / SMB_PASS when unset, so one
# service account can cover both collectors.
#   HV_USER=longlewis\svc-gatus
# Running Get-CimInstance and Get-VM over WinRM needs local Administrators on
# each host, or a delegated WinRM session configuration.
# Hosts with WinRM disabled report DEGRADED with "WinRM is not listening"
# rather than down, because the TCP liveness probe still succeeds. Fix on the
# host with:  Enable-PSRemoting -Force
HV_USER=
HV_PASS=
# Degraded (amber, not a down alert) above these.
HV_CPU_WARN=90
HV_MEM_WARN=92
HV_DISK_WARN=90

# --- Hardened WinRM (collector/winrm-harden.ps1) --------------------------
# Once a hypervisor has been hardened, the collector authenticates with a
# CLIENT CERTIFICATE against a JEA endpoint that exposes one read-only
# function, over TLS, from one permitted address. HV_USER / HV_PASS are then
# not used for that host at all.
#
# The certificate paths are set in docker-compose.yml (they are paths, not
# secrets). Nothing to put here unless you are overriding the defaults:
#   HV_WINRM_MODE=auto    auto | jea | ntlm
#   HV_JEA_PORT=5986
#   HV_JEA_CONFIG=GatusInventory
#
# Setup is in docs/winrm-hardening.md. Short version:
#   1. collector/winrm-make-certs.sh                        (once)
#   2. collector/winrm-make-host-cert.sh  per host          (recommended)
#   3. collector/winrm-harden.ps1         on each host, elevated
